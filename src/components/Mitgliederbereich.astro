---
// Geschützter Mitgliederbereich (Vorlagen-Tausch), DE/EN.
// Statische Hülle – Login, Liste, Hochladen und Admin baut src/scripts/mitglieder/app.ts
// zur Laufzeit über die PHP-API (public/php/mitglieder/api.php). Persistente Daten liegen
// ausserhalb von httpdocs (siehe README, Abschnitt «Mitgliederbereich»).
interface Props {
  locale?: 'de' | 'en';
}
const { locale = 'de' } = Astro.props;
const en = locale === 'en';
---

<section class="section section--white mb-section">
  <div class="container">
    <div id="mb" data-locale={locale}>
      <p id="mb-laden" class="mb-leer">{en ? 'Loading …' : 'Wird geladen …'}</p>
      <noscript><p class="mb-leer">{en ? 'The members’ area needs JavaScript.' : 'Der Mitgliederbereich braucht JavaScript.'}</p></noscript>
      <div id="mb-login" hidden></div>
      <div id="mb-bereich" hidden>
        <div class="mb-kopf" id="mb-kopf"></div>
        <div class="mb-reiter" id="mb-reiter" role="tablist"></div>
        <div data-panel="vorlagen" role="tabpanel"></div>
        <div data-panel="hochladen" role="tabpanel" hidden></div>
        <div data-panel="admin" role="tabpanel" hidden></div>
      </div>
      <p id="mb-meldung" class="mb-meldung" role="status" aria-live="polite" hidden></p>
      <dialog id="mb-dialog" class="mb-dialog"></dialog>
    </div>
  </div>
</section>

<script>
  import '../scripts/mitglieder/app.ts';
</script>

<style is:global>
  /* Mitgliederbereich – Farben/Abstände aus global.css, mobil zuerst */
  .mb-section { padding-block: var(--space-6) var(--space-10); }
  #mb { --mb-rot: #b91c1c; --mb-gelb-bg: #fff7ed; --mb-gelb-rand: #fdba74; }

  .mb-leer { color: var(--color-text); opacity: 0.8; padding-block: var(--space-4); }
  .mb-klein { font-size: var(--text-sm); color: var(--color-text); opacity: 0.85; }
  .mb-karte { background: var(--color-white); border: var(--card-border); border-radius: var(--radius-md); box-shadow: var(--shadow-card); padding: var(--space-4); }
  .mb-karte h2 { font-size: 1.5rem; }
  .mb-login { max-width: 560px; margin-inline: auto; }
  .mb-login .mb-klein { margin-top: var(--space-3); }

  /* Formulare (Stil wie Gewerbeangebote.astro) */
  .mb-form { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-2); }
  .mb-form--reihe { display: grid; grid-template-columns: 1fr; gap: var(--space-2); align-items: end; }
  .mb-feld { display: flex; flex-direction: column; gap: 0.375rem; border: 0; min-width: 0; }
  .mb-feld > span, .mb-feld > legend { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
  .mb-feld input, .mb-feld select, .mb-feld textarea {
    padding: 0.7rem 0.9rem; border: 1.5px solid var(--color-border); border-radius: var(--radius-sm);
    font-family: var(--font-sans); font-size: 1rem; color: var(--color-text); background: var(--color-white); width: 100%;
  }
  .mb-feld input:focus-visible, .mb-feld select:focus-visible, .mb-feld textarea:focus-visible {
    outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(0, 77, 122, 0.2);
  }
  .mb-check { display: flex; gap: var(--space-1); align-items: flex-start; font-size: var(--text-sm); cursor: pointer; }
  .mb-check input { width: 18px; height: 18px; margin-top: 2px; accent-color: var(--color-primary); flex-shrink: 0; }
  .mb-link {
    background: none; border: 0; padding: 0.25rem 0; font: inherit; font-size: var(--text-sm); font-weight: 600;
    color: var(--color-primary); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; align-self: flex-start;
  }
  .mb-link--rot { color: var(--mb-rot); }
  .mb-btn-klein { padding: 0.55rem 1.1rem; }
  .mb-nowrap { white-space: nowrap; }

  /* Kopf + Reiter */
  .mb-kopf { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-1) var(--space-2); margin-bottom: var(--space-3); }
  .mb-reiter { display: flex; gap: var(--space-1); border-bottom: 2px solid var(--color-border); margin-bottom: var(--space-3); overflow-x: auto; }
  .mb-reiter button {
    background: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -2px; padding: 0.7rem 1rem;
    font-family: var(--font-heading); font-weight: 600; font-size: 1rem; color: var(--color-text); cursor: pointer; white-space: nowrap;
  }
  .mb-reiter button[aria-selected='true'] { color: var(--color-primary); border-bottom-color: var(--color-accent); }

  /* Filter */
  .mb-filter { background: var(--color-bg-subtle); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-2); }
  .mb-filter summary { cursor: pointer; font-family: var(--font-heading); font-weight: 600; color: var(--color-heading); }
  .mb-filter__felder { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin-top: var(--space-2); align-items: end; }
  .mb-feld--breit { grid-column: 1 / -1; }
  .mb-filter .mb-check { grid-column: 1 / -1; }
  .mb-filter .mb-link { grid-column: 1 / -1; }
  .mb-pill { display: inline-block; background: var(--color-bg-subtle); border: 1px solid rgba(0, 77, 122, 0.2); color: var(--color-primary); border-radius: var(--radius-full); padding: 0.1rem 0.6rem; font-size: 0.8rem; font-weight: 600; }
  .mb-filter summary .mb-pill { background: var(--color-primary); color: var(--color-white); margin-left: 0.4rem; }
  .mb-treffer { font-size: var(--text-sm); font-weight: 600; margin-bottom: var(--space-2); }

  /* Karten */
  .mb-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-3); }
  .mb-doc { display: flex; flex-direction: column; overflow: hidden; }
  .mb-doc--hervor { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .mb-doc__bild { aspect-ratio: 4 / 3; background: var(--color-bg-subtle); display: flex; align-items: center; justify-content: center; border-bottom: var(--card-border); }
  .mb-doc__bild img { width: 100%; height: 100%; object-fit: contain; }
  .mb-doc__format { font-family: var(--font-heading); font-weight: 700; font-size: 1.4rem; color: var(--color-primary); opacity: 0.7; }
  .mb-doc__inhalt { padding: var(--space-2) var(--space-3) var(--space-3); display: flex; flex-direction: column; gap: 0.35rem; flex: 1; }
  .mb-doc__titel { font-size: 1.15rem; margin: 0; overflow-wrap: anywhere; }
  .mb-doc__meta, .mb-doc__autor { font-size: var(--text-sm); }
  .mb-doc__name { overflow-wrap: anywhere; font-family: ui-monospace, Menlo, monospace; font-size: 0.75rem; }
  .mb-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .mb-doc__knoepfe { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-1) var(--space-2); margin-top: auto; padding-top: var(--space-2); }
  .mb-doc__admin { border-top: 1px dashed var(--color-border); margin-top: var(--space-1); }
  .mb-status { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .mb-status--wartet { color: #9a3412; }
  .mb-status--versteckt, .mb-status--abgelehnt { color: var(--mb-rot); }
  .mb-status::before { content: '● '; }
  .mb-meldungen { font-size: var(--text-sm); background: var(--mb-gelb-bg); border-left: 3px solid var(--mb-gelb-rand); padding: var(--space-1) var(--space-2) var(--space-1) var(--space-4); }
  .mb-erledigt { opacity: 0.6; text-decoration: line-through; }

  /* Hochladen */
  .mb-upload { max-width: 820px; }
  .mb-drop {
    display: flex; flex-direction: column; align-items: center; gap: var(--space-1); text-align: center;
    border: 2px dashed rgba(0, 77, 122, 0.35); border-radius: var(--radius-md); padding: var(--space-4) var(--space-2);
    background: var(--color-bg-subtle); cursor: pointer;
  }
  .mb-drop--aktiv { border-color: var(--color-accent); background: var(--mb-gelb-bg); }
  .mb-drop input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .mb-drop:focus-within { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .mb-drop__name { font-size: var(--text-sm); font-weight: 600; overflow-wrap: anywhere; }
  .mb-hinweis { font-size: var(--text-sm); background: var(--color-bg-subtle); border-left: 3px solid var(--color-secondary); padding: var(--space-1) var(--space-2); }
  .mb-up-raster { display: grid; grid-template-columns: 1fr; gap: var(--space-3); margin-block: var(--space-2); }
  .mb-up-vorschau { aspect-ratio: 4 / 3; background: var(--color-bg-subtle); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; overflow: hidden; max-width: 320px; }
  .mb-up-vorschau img { width: 100%; height: 100%; object-fit: contain; }
  .mb-up-felder { display: flex; flex-direction: column; gap: var(--space-2); }
  .mb-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .mb-chip input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .mb-chip span { display: inline-block; border: 1.5px solid var(--color-border); border-radius: var(--radius-full); padding: 0.3rem 0.8rem; font-size: var(--text-sm); cursor: pointer; background: var(--color-white); }
  .mb-chip input:checked + span { background: var(--color-primary); border-color: var(--color-primary); color: var(--color-white); }
  .mb-chip input:checked + span::before { content: '✓ '; }
  .mb-chip input:focus-visible + span { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .mb-anonym { background: var(--mb-gelb-bg); border: 1px solid var(--mb-gelb-rand); border-radius: var(--radius-md); padding: var(--space-2); margin-top: var(--space-2); }
  .mb-anonym .mb-klein { margin-top: 0.3rem; }
  .mb-name { font-size: var(--text-sm); margin-top: var(--space-2); overflow-wrap: anywhere; }
  .mb-name code { background: var(--color-bg-subtle); padding: 0.1rem 0.35rem; border-radius: var(--radius-sm); }
  .mb-protokoll { margin-top: var(--space-1); }
  .mb-fortschritt { height: 6px; background: var(--color-bg-subtle); border-radius: var(--radius-full); overflow: hidden; margin-top: var(--space-2); }
  .mb-fortschritt span { display: block; height: 100%; width: 0; background: var(--color-accent); transition: width 0.2s; }
  .mb-up-knoepfe { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: var(--space-3); }
  .mb-lader { width: 32px; height: 32px; border: 3px solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: mb-dreh 0.8s linear infinite; }
  @keyframes mb-dreh { to { transform: rotate(360deg); } }

  /* Meldungen + Dialog */
  .mb-meldung {
    position: fixed; left: 50%; bottom: var(--space-3); transform: translateX(-50%); z-index: 50;
    max-width: min(560px, calc(100vw - 2rem)); padding: var(--space-2) var(--space-3); border-radius: var(--radius-md);
    box-shadow: var(--shadow-card-hover); font-size: var(--text-sm); font-weight: 600;
  }
  .mb-meldung--ok { background: var(--color-primary); color: var(--color-white); }
  .mb-meldung--fehler { background: #fff5f5; color: var(--mb-rot); border: 1px solid #fecaca; }
  .mb-meldung--fehler::before { content: '⚠ '; }
  .mb-dialog { border: 0; border-radius: var(--radius-md); padding: var(--space-4); width: min(560px, calc(100vw - 2rem)); box-shadow: var(--shadow-card-hover); }
  .mb-dialog::backdrop { background: rgba(15, 23, 42, 0.5); }
  .mb-dialog h2 { font-size: 1.35rem; }

  /* Admin */
  .mb-admin-teil { margin-bottom: var(--space-6); }
  .mb-admin-teil > h2 { font-size: 1.4rem; }
  .mb-tabelle-wrap { overflow-x: auto; margin-top: var(--space-3); }
  .mb-tabelle { width: 100%; border-collapse: collapse; font-size: var(--text-sm); }
  .mb-tabelle th, .mb-tabelle td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .mb-tabelle th { font-weight: 600; background: var(--color-bg-subtle); }
  .mb-tabelle--klein { font-size: 0.8rem; }
  .mb-tabelle--klein td:last-child { min-width: 16rem; }
  .mb-gesperrt td { opacity: 0.7; }

  @media (min-width: 600px) {
    .mb-grid { grid-template-columns: repeat(2, 1fr); }
    .mb-up-raster { grid-template-columns: 240px 1fr; }
  }
  @media (min-width: 861px) {
    .mb-filter__felder { grid-template-columns: repeat(3, 1fr); }
    .mb-filter .mb-check, .mb-filter .mb-link { grid-column: auto; }
    .mb-form--reihe { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); }
  }
  @media (min-width: 1000px) {
    .mb-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
