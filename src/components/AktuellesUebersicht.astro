---
// Übersicht «Aktuelles»: Beiträge + kommende/vergangene Anlässe. DE und EN teilen sich das Layout.
import { render } from 'astro:content';
import { getLokalisiert, slugOf, formatDatum, type Locale } from '../lib/inhalte';
import Icon from './Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = locale === 'en'
  ? { h1: 'News', lead: 'News from the association, upcoming events and documents.', posts: 'Posts', none: 'No posts yet.', events: 'Upcoming events', past: 'Past events', noEvents: 'No events scheduled at the moment.', more: 'Read more', register: 'Register', downloads: 'Documents & downloads', base: '/en/news/', dl: '/en/downloads/' }
  : { h1: 'Aktuelles', lead: 'Neuigkeiten aus dem Verein, kommende Anlässe und Dokumente.', posts: 'Beiträge', none: 'Noch keine Beiträge.', events: 'Kommende Anlässe', past: 'Vergangene Anlässe', noEvents: 'Zurzeit sind keine Anlässe geplant.', more: 'Weiterlesen', register: 'Anmelden', downloads: 'Dokumente & Downloads', base: '/aktuelles/', dl: '/downloads/' };

const beitraege = (await getLokalisiert('aktuelles', locale)).sort((a, b) => b.data.datum.getTime() - a.data.datum.getTime());
const anlaesse = (await getLokalisiert('veranstaltungen', locale)).sort((a, b) => a.data.beginn.getTime() - b.data.beginn.getTime());
const jetzt = new Date();
const kommend = anlaesse.filter((a) => (a.data.ende ?? a.data.beginn) >= jetzt);
const vergangen = anlaesse.filter((a) => (a.data.ende ?? a.data.beginn) < jetzt).reverse().slice(0, 10);
const gerendert = await Promise.all(anlaesse.map(async (a) => [a.id, (await render(a)).Content] as const));
const contentOf = new Map(gerendert);
---

<section class="section page-hero hero--intro">
  <div class="container">
    <h1>{t.h1}</h1>
    <p>{t.lead}</p>
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <h2>{t.posts}</h2>
    {beitraege.length === 0 && <p>{t.none}</p>}
    <div class="posts">
      {beitraege.map((b) => (
        <article class="post-card">
          {b.data.bild && <a href={`${t.base}${slugOf(b.id)}/`}><img src={b.data.bild} alt={b.data.bild_alt ?? ''} loading="lazy" /></a>}
          <div class="post-card__body">
            <p class="eyebrow"><time datetime={b.data.datum.toISOString()}>{formatDatum(b.data.datum, locale)}</time></p>
            <h3><a href={`${t.base}${slugOf(b.id)}/`}>{b.data.titel}</a></h3>
            <p>{b.data.teaser}</p>
            <a href={`${t.base}${slugOf(b.id)}/`} class="text-link-strong">{t.more} →</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--subtle" id="anlaesse">
  <div class="container">
    <h2>{t.events}</h2>
    {kommend.length === 0 && <p>{t.noEvents}</p>}
    <div class="events">
      {kommend.map((a) => { const Content = contentOf.get(a.id)!; return (
        <article class="event">
          <div class="event__date">
            <span class="event__day">{a.data.beginn.toLocaleString('de-CH', { day: '2-digit', timeZone: 'Europe/Zurich' })}</span>
            <span class="event__month">{a.data.beginn.toLocaleString(locale === 'en' ? 'en-GB' : 'de-CH', { month: 'short', year: 'numeric', timeZone: 'Europe/Zurich' })}</span>
          </div>
          <div class="event__body">
            <h3>{a.data.titel}</h3>
            <p class="event__meta">
              <Icon name="calendar" size={16} /> {formatDatum(a.data.beginn, locale, true)}
              {a.data.ort && <> · {a.data.ort}</>}
            </p>
            <div class="event__text"><Content /></div>
            {a.data.anmeldelink && <a href={a.data.anmeldelink} class="btn btn-accent" target="_blank" rel="noopener">{t.register}</a>}
          </div>
        </article>
      ); })}
    </div>
    {vergangen.length > 0 && (
      <details class="past">
        <summary>{t.past}</summary>
        <ul>
          {vergangen.map((a) => <li><time datetime={a.data.beginn.toISOString()}>{formatDatum(a.data.beginn, locale)}</time> – {a.data.titel}{a.data.ort && ` · ${a.data.ort}`}</li>)}
        </ul>
      </details>
    )}
  </div>
</section>

<section class="section section--white">
  <div class="container">
    <a href={t.dl} class="text-link-strong">{t.downloads} →</a>
  </div>
</section>

<style>
  .posts { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); margin-top: var(--space-3); }
  .post-card { border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-bg-subtle); overflow: hidden; display: flex; flex-direction: column; }
  .post-card img { width: 100%; aspect-ratio: 16/9; object-fit: cover; }
  .post-card__body { padding: var(--space-3); display: flex; flex-direction: column; gap: var(--space-1); }
  .post-card h3 { margin: 0; }
  .post-card h3 a { color: var(--color-heading); text-decoration: none; }
  .post-card h3 a:hover { color: var(--color-primary); }
  .events { display: grid; gap: var(--space-3); margin-top: var(--space-3); }
  .event { display: grid; grid-template-columns: 5rem 1fr; gap: var(--space-3); background: var(--color-white); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); }
  .event__date { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--color-primary); color: var(--color-white); border-radius: var(--radius-sm); padding: var(--space-1); text-align: center; }
  .event__day { font-size: 1.75rem; font-weight: 700; line-height: 1; }
  .event__month { font-size: var(--text-sm, 0.875rem); }
  .event__meta { display: flex; align-items: center; gap: 0.4em; color: var(--color-text); font-size: var(--text-sm, 0.875rem); margin-bottom: var(--space-1); }
  .event__text :global(p:last-child) { margin-bottom: var(--space-2); }
  .past { margin-top: var(--space-4); }
  .past summary { cursor: pointer; font-weight: 600; color: var(--color-primary); }
  .past ul { margin-top: var(--space-2); padding-left: 1.2em; }
  @media (max-width: 600px) { .event { grid-template-columns: 1fr; } .event__date { flex-direction: row; gap: 0.5em; } }
</style>
