---
import Layout from '../../../layouts/Layout.astro';
import AktuellesBeitrag from '../../../components/AktuellesBeitrag.astro';
import { getLokalisiert, slugOf } from '../../../lib/inhalte';

export async function getStaticPaths() {
  const beitraege = await getLokalisiert('aktuelles', 'en');
  return beitraege.map((b) => ({ params: { slug: slugOf(b.id) }, props: { beitrag: b } }));
}
const { beitrag } = Astro.props;
---
<Layout title={`${beitrag.data.titel} - Ferienwohnungsverein Jungfrau`} description={beitrag.data.teaser} langAlt={`/aktuelles/${slugOf(beitrag.id)}/`}>
  <AktuellesBeitrag locale="en" beitrag={beitrag} />
</Layout>
