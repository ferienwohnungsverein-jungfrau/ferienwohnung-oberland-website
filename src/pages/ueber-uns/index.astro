---
import Layout from '../../layouts/Layout.astro';
import BoardAccordion from '../../components/BoardAccordion.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { Image } from 'astro:assets';
import sujet3 from '../../assets/images/ferienwohnungsverein-jungfrau-sujet-3.jpg';
import sujet4 from '../../assets/images/ferienwohnungsverein-jungfrau-sujet-4.jpg';
import { getSeitenTexte, md } from '../../lib/inhalte';
const t = await getSeitenTexte('ueber-uns', 'de');
---

<Layout
  title="Wer wir sind - Ferienwohnungsverein Jungfrau"
  description="Wir sind Gastgeber:innen im Berner Oberland – engagiert, vernetzt, verantwortungsvoll. Gemeinsam vertreten wir die Interessen lokaler Ferienwohnungsanbieter:innen."
  langAlt="/en/about-us/"
>
  <!-- Hero -->
  <section class="section page-hero hero--intro">
    <div class="container">
      <h1>Wer wir sind</h1>
      <p>{t.hero_text}</p>
    </div>
  </section>

  <!-- Unser Vorstand -->
  <section class="section section--white" id="unseretätigkeit">
    <div class="container grid-2">
      <div>
        <h2>Unser Vorstand</h2>
        <div class="intro-text" set:html={md(t.vorstand_intro)} />
        <BoardAccordion />
      </div>
      <Image src={sujet3} alt="" width={500} />
    </div>
  </section>

  <!-- Warum wir vermieten -->
  <section class="section section--subtle">
    <div class="container grid-2">
      <div>
        <h2>{t.warum_titel}</h2>
        <div class="md" set:html={md(t.warum_text)} />
        <a href="/unser-vorschlag/" class="btn btn-accent">Unser Vorschlag zur Kurzzeitvermietung</a>
      </div>
      <Image src={sujet4} alt="" width={1024} height={739} />
    </div>
  </section>

  <!-- Video + mehr Einsatz -->
  <section class="section section--white">
    <div class="container grid-2">
      <YouTubeEmbed id="oYg1nMOCFbs" title="Ferienwohnungsbetreibende Berner Oberland" />
      <div>
        <h2>{t.einsatz_titel}</h2>
        <div class="md" set:html={md(t.einsatz_text)} />
      </div>
    </div>
  </section>

  <!-- Vielfalt unserer Rollen -->
  <section class="section page-hero">
    <div class="container">
      <h2>{t.rollen_titel}</h2>
        <div class="md" set:html={md(t.rollen_text)} />
      <a href="/mitgliedschaft/" class="btn btn-accent">Mitglied werden</a>
    </div>
  </section>
</Layout>

<style>
  .md :global(p) { margin-bottom: var(--space-2); }
  .intro-text :global(p) { margin: 0; }

  .intro-text {
    font-size: var(--text-lg);
    max-width: 60ch;
  }

  .grid-2 h2 {
    margin-bottom: var(--space-2);
  }

  .grid-2 p {
    margin-bottom: var(--space-2);
  }

  .grid-2 .btn {
    margin-top: var(--space-2);
  }

  .page-hero .btn {
    margin-top: var(--space-3);
  }
</style>
